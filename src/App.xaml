<Application x:Class="ReunionLocale.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReunionLocale">
 <Application.Resources>
  <local:VoiceColor x:Key="VoiceColor"/>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{Binding VoiceId, Converter={StaticResource VoiceColor}}"/></Style>
  <SolidColorBrush x:Key="Bg" Color="#101725"/><SolidColorBrush x:Key="Panel" Color="#1B2639"/><SolidColorBrush x:Key="Ink" Color="#F0F4FA"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#BBECDD"/><Setter Property="Foreground" Value="#132B29"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Panel}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="#53647B"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/><Setter Property="Foreground" Value="#142033"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 </Application.Resources>
</Application>

